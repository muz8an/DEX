# Packaging and build outputs
target/
dist/
*.class

# Android build outputs & local properties
mobile/.gradle/
mobile/build/
mobile/*/build/
mobile/local.properties
*.apk.tmp

# Keystores & signing secrets
*.jks
*.keystore

# Persistent personal memory, paired devices, and workspace
data/memory.json
data/memory.json.tmp
data/providers.json
data/paired_devices.json
data/screenshots/
workspace/

# Environment files and credentials
.env
*.env
*.key
*.pem
*.enc
data/.dex_salt
data/secrets.enc
data/facts.json
data/facts.json.tmp
credentials.json

# Logs and temporary files
*.log
*.tmp

# IDE / Editor configuration
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Windows system files
Thumbs.db
desktop.ini

# Explicitly ensure distributable release assets are tracked
!assets/*.exe
!assets/*.apk
!assets/*.txt

