<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="visible">

    <!-- Top App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_assistant_logo"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="DEX"
                android:textColor="@color/text_title_maroon"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHomeStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tag_inactive"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="OFFLINE"
                android:textColor="@color/status_offline"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnHomeFullscreen"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_icon"
                android:padding="7dp"
                android:src="@drawable/ic_fullscreen"
                android:contentDescription="Toggle Fullscreen" />

            <ImageView
                android:id="@+id/btnProfileAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_profile_circle"
                android:padding="7dp"
                android:src="@drawable/ic_profile"
                android:contentDescription="Profile" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Scrollable Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Good Morning,"
                android:textColor="@color/text_title_maroon"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvHomeUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/user_name"
                android:textColor="@color/text_title_maroon"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="What would you like DEX to do on your laptop?"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Search Input Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search" />

                <EditText
                    android:id="@+id/etHomeSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search or command laptop..."
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 2x2 Feature Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardHomeChat"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="9dp"
                        android:src="@drawable/ic_chat"
                        android:contentDescription="Chat" />

                    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chat" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ask anything" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:background="@drawable/bg_circle_arrow" android:padding="5dp" android:src="@drawable/ic_arrow_right" android:contentDescription="Open" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardHomeVoice"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="9dp"
                        android:src="@drawable/ic_mic"
                        android:contentDescription="Voice" />

                    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Voice" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speak &amp; get insights" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:background="@drawable/bg_circle_arrow" android:padding="5dp" android:src="@drawable/ic_arrow_right" android:contentDescription="Open" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardHomeImage"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="9dp"
                        android:src="@drawable/ic_image"
                        android:contentDescription="Vision" />

                    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vision" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Screen analysis" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:background="@drawable/bg_circle_arrow" android:padding="5dp" android:src="@drawable/ic_arrow_right" android:contentDescription="Open" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardHomeFiles"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="9dp"
                        android:src="@drawable/ic_file_text"
                        android:contentDescription="File Analysis" />

                    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="File Analysis" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Documents, code, more" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:background="@drawable/bg_circle_arrow" android:padding="5dp" android:src="@drawable/ic_arrow_right" android:contentDescription="Open" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Topics Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_flash"
                        android:contentDescription="Quick Topics" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Quick Topics"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnHomeSeeAllTopics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="See All"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </RelativeLayout>

            <!-- Quick Topics -->
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="4dp">
                    <TextView android:id="@+id/tagDailyLife" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_tag_active" android:paddingHorizontal="18dp" android:paddingVertical="10dp" android:text="Daily Life" android:textColor="@color/text_white" android:textSize="13sp" />
                    <TextView android:id="@+id/tagStudy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/bg_tag_inactive" android:paddingHorizontal="18dp" android:paddingVertical="10dp" android:text="Study" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tagBusiness" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/bg_tag_inactive" android:paddingHorizontal="18dp" android:paddingVertical="10dp" android:text="Business" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tagHealth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/bg_tag_inactive" android:paddingHorizontal="18dp" android:paddingVertical="10dp" android:text="Health" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tagDevelopment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/bg_tag_inactive" android:paddingHorizontal="18dp" android:paddingVertical="10dp" android:text="Development" android:textColor="@color/text_secondary" android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <View android:layout_width="match_parent" android:layout_height="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Floating Message Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input_dock"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/btnHomePlus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_plus"
            android:contentDescription="Quick Actions" />

        <EditText
            android:id="@+id/etHomeMessage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Type a message..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:paddingHorizontal="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnHomeMic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="Voice" />

        <ImageView
            android:id="@+id/btnHomeSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_maroon"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            android:contentDescription="Send" />
    </LinearLayout>
</LinearLayout>
