<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DexCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card_rounded</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="DexInputPill">
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_pill_search</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DexButtonPrimary" parent="@android:style/Widget.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_tag_active</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="DexButtonSecondary" parent="@android:style/Widget.Button">
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_tag_inactive</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="DexQuickLaunchBtn" parent="DexButtonSecondary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="DexRemoteMiniBtn" parent="DexButtonSecondary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
